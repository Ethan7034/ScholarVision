# ===== Scholar Vision v2.1 environment template =====
# Copy to .env and fill in real values. .env is gitignored; never commit secrets.

# --- AI model (Layer 5) ---
INTERN_API_KEY=your-i…here

# --- Security (Layer 2) ---
# MUST change before publishing: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change…ring
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Set true when serving through a Cloudflare Tunnel over HTTPS
COOKIE_SECURE=false

# --- Data layer (Layer 7) ---
DATABASE_URL=sqlite:///./scholar_vision.db
# Local Redis: redis://localhost:6379/0 ; inside docker compose: redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# --- Cache & concurrency tuning ---
CACHE_TTL_ANALYZE=86400
CACHE_TTL_SEARCH=600
MAX_CONCURRENT_ANALYSIS=3

# --- Queue & worker (v2.1) ---
# When Redis is reachable, jobs go to QUEUE_NAME and python worker.py consumes
# them. Without Redis the API falls back to in-process execution and these
# settings are simply unused.
QUEUE_NAME=sv:queue:analyze
PROCESSING_LIST=sv:queue:processing
WORKER_CONCURRENCY=2
